{
  "name": "fzy-search-workspace",
  "private": true,
  "description": "The fzy-search monorepo: the library in packages/fzy-search, the playground in apps/playground.",
  "type": "module",
  "scripts": {
    "release": "node scripts/release.mjs",
    "bench": "npm ci --prefix bench --ignore-scripts && node --expose-gc bench/run.js",
    "bench:all": "npm ci --prefix bench --ignore-scripts && node bench/sweep.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "git-cliff": "^2.0.0",
    "pkg-pr-new": "^0.0.92",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
